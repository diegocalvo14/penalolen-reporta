# =====================================================================
# Variables para desarrollo local (npm run dev). Copia este archivo a .env
# Nunca subas el .env a git.
# =====================================================================

# Base de datos (la levanta docker compose: servicio "db")
DATABASE_URL="postgresql://reporta:reporta@localhost:5432/reporta"

# Secreto para firmar la sesión (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-64-caracteres"

# true = muestra los usuarios demo en la pantalla de login
DEMO_MODE=true

# Contraseña de los usuarios demo que crea `npm run db:seed`
SEED_PASSWORD="Demo2026!"

# Cookie de sesión: auto (según http/https), true o false
COOKIE_SECURE=auto

# Orígenes extra para `next dev` (por ejemplo el celular entrando por la IP del PC)
# DEV_ALLOWED_ORIGINS=192.168.1.20

# Servicio de visión (FastAPI + YOLOv8)
VISION_URL="http://localhost:8000"
VISION_API_KEY=""

# Copiloto: LM Studio (:1234) u Ollama (:11434), API compatible con OpenAI
LOCAL_LLM_URL="http://127.0.0.1:1234/v1"
OLLAMA_LLM_URL="http://127.0.0.1:11434/v1"
LLM_MODEL=""
LLM_INFERENCE_TIMEOUT_MS=20000

# Carpeta de fotos (fuera de git). Relativa a apps/web
UPLOAD_DIR="../../uploads"

# Base para pruebas de integración (opcional; debe contener "test" en el nombre: se borra y recrea)
# TEST_DATABASE_URL="postgresql://reporta:reporta@localhost:5432/reporta_test"
