# Variables para docker compose (copia este archivo a infra/.env). Nunca lo subas a git.

POSTGRES_USER=reporta
POSTGRES_PASSWORD=reporta
POSTGRES_DB=reporta
DB_PORT=5432

# Solo para la demo completa (--profile app). Mínimo 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-64-caracteres
DEMO_MODE=true
SEED_PASSWORD=Demo2026!
COOKIE_SECURE=auto
WEB_PORT=3000

# Servicio de visión
VISION_PORT=8000
VISION_DEFAULT_ENGINE=ensemble
VISION_MODEL_PRETRAINED=yolov8s_pothole_pretrained.pt
VISION_MODEL_LOCAL=best_obb_80ep.pt
# API key interna web ↔ visión (RF-11.3). Si la defines, pon la misma en apps/web/.env
VISION_API_KEY=

# Copiloto (LM Studio u Ollama corriendo en este mismo PC)
LOCAL_LLM_URL=http://host.docker.internal:1234/v1
OLLAMA_LLM_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_INFERENCE_TIMEOUT_MS=20000
